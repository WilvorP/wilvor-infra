# Base URL of the deployed Wilvor operational API (API Gateway HTTP API).
#
# Obtain it from Terraform after `scripts/dev-up.ps1`:
#
#   cd envs/dev
#   terraform output -raw operational_api_endpoint
#
# No trailing slash. Routes are appended directly (e.g. `${BASE}/overview`).
VITE_WILVOR_API_BASE_URL= https://1atoq9yyc4.execute-api.us-west-1.amazonaws.com 

# Optional. Request timeout in milliseconds before a query is aborted.
# The operational API Lambda has a 30s timeout; API Gateway integration is 29s.
VITE_WILVOR_API_TIMEOUT_MS=30000

# Optional. MapLibre style URL. When unset, the built-in dark CARTO basemap is
# used. Set this to use a self-hosted or vendor style.
# VITE_WILVOR_MAP_STYLE_URL=

# Optional. CARTO basemap API key for the built-in dark tiles.
# Without it, tiles may watermark "API KEY REQUIRED".
# Put the real value in `.env.local` — never commit it.
# VITE_CARTO_BASEMAP_KEY=
